{
  "name": "travelbridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "coverage": "jest --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "node prisma/seed.cjs"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "leaflet": "^1.9.4",
    "micro": "^10.0.1",
    "next": "13.4.7",
    "prisma": "^5.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-leaflet": "^4.2.1",
    "stripe": "^11.0.0",
    "swr": "^2.2.0"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [ "<rootDir>/src" ],
    "testMatch": [ "**/*.test.js" ],
    "collectCoverageFrom": [
      "src/controllers/**/*.js",
      "src/services/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
